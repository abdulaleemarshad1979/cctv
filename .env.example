# ==============================================================================
# Pushkaralu Crowd Control - Production Environment Configuration
# Target Date: August 4, 2026
# ==============================================================================

# Dashboard Drone Capacity & Dynamic AI Concurrency
MAX_DRONE_SLOTS=60
MAX_CONCURRENT_AI_FEEDS=4
AUTO_START_AI=false
CCTV_COUNT=0

# Operations fleet inventory. This can be larger than MAX_DRONE_SLOTS: the
# mission console coordinates 250 aircraft while the existing dashboard keeps
# its current 60 concurrent stream slots and AI workload.
MISSION_FLEET_SIZE=250
# Mission state and its append-only audit trail are written under /app/outputs,
# which is already persisted by docker-compose.yml.
MISSION_CONTROL_DATA_FILE=/app/outputs/mission_control.json
MISSION_CONTROL_AUDIT_FILE=/app/outputs/mission_audit.jsonl

# Role-Based Authentication & Session Security
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_in_prod
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=change_this_viewer_password_in_prod
SECRET_KEY=generate_a_long_random_secret_key_for_hmac_signing

# Hardware & Engine Settings
DEVICE=cpu
ENABLE_RECORDING=false

# Processing & Inference Optimization
CPU_USE_FUSION=0
CPU_USE_HYBRID=0
COUNT_FLIP_TTA=0

# Resolution & Frame Rate Settings
CPU_MAX_INFER_WIDTH=384
CPU_MAX_INFER_HEIGHT=216

WEB_STREAM_WIDTH=640
WEB_STREAM_HEIGHT=360
OUTPUT_STREAM_FPS=15

# Counting Temporal Window & Filter Settings
COUNT_TEMPORAL_WINDOW=1
COUNT_EMA_ALPHA=1.0

# Telemetry & Performance
RENDER_VIDEO_OVERLAYS=0
PROFILE_PIPELINE=0
PERF_METRICS_ENABLED=0

ANALYTICS_STALE_AFTER_SECONDS=30

# Counting workers: how many run at once (the rest are queued), how the CPU
# cores are shared, and how long they rest between passes. COUNT_MAX_DUTY=0.5
# keeps a worker's cores busy half the time (a result every ~2 s on CPU);
# raise towards 0.9 for faster updates when you have spare cores.
# MAX_CONCURRENT_AI_FEEDS is set above.
# AI_TORCH_THREADS=1
COUNT_MAX_DUTY=0.5
# A worker with no first count after this long, or no new count for the second
# value, is restarted.
ANALYTICS_START_TIMEOUT_SECONDS=150
ANALYTICS_RESTART_AFTER_STALE_SECONDS=120

# Adaptive quality: transcoder slots. A viewer in full-screen may take a slot
# from a grid tile when all are busy.
ABR_MAX_SESSIONS=4

# MediaMTX & Host Configuration
CCTV_PUBLISH_HOST=publish.dmsegpolice.in
MEDIAMTX_HOST=mediamtx
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_API_PORT=9997
MEDIAMTX_STATE_POLL_SECONDS=2
# Must equal readTimeout in deployment/mediamtx.yml (seconds).
MEDIAMTX_READ_TIMEOUT_SECONDS=20

# Recordings archive: files closer than this (s) form one flight, played as
# one video straight from the original files (no copies are stored).
RECORDING_FLIGHT_GAP_SECONDS=120
# How long one scan of the recordings folder is reused (s).
RECORDINGS_SCAN_TTL_SECONDS=15
